# Copia in .env.local e compila con i dati del tuo progetto Firebase.
# Se lasci vuoto, l'app parte in modalità demo con i dati salvati nel browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Identificativo dell'azienda (tenant). Una sola azienda per ora.
VITE_TENANT_ID=mk-service
